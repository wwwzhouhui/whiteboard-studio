# Optional AI provider key: configure through the shared Connect AI UI, or server deployment environment.
# Never commit actual credentials.
MI_TTS_API_KEY=
MI_TTS_BASE_URL=https://api.xiaomimimo.com/v1
VOLC_TTS_API_KEY=
# Optional local Chromium executable if the Playwright browser cannot be downloaded.
WB_CHROMIUM=

# Optional: local OpenAI-compatible model server (vLLM / Ollama), see CHANGES-2026-10-30.md
# LOCAL_MODEL_BASE_URL=http://127.0.0.1:8000/v1
# LOCAL_MODEL_ID=Qwen3-8B
# LOCAL_MODEL_LABEL=Qwen3-8B (local vLLM)
# LOCAL_MODEL_API_KEY=EMPTY
# Keep completion tokens under the local model's context window.
# AGENT_MAIN_CHAT_MAX_OUTPUT_TOKENS=8192
# AGENT_EMPTY_RESPONSE_RETRY_MAX_OUTPUT_TOKENS=8192
# Extra JSON body fields for loopback/private endpoints only (Qwen3: disable thinking).
# LOCAL_MODEL_CHAT_TEMPLATE_KWARGS={"enable_thinking":false}
